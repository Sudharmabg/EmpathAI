#### [MODIFY] [validators.py](file:///c:/mymercurie_updated_new/MyMercurie/MyMercurieAI/curriculum/validators.py)
```python
# New models
class FormulaItem(BaseModel):
    name: str
    formula: str       # LaTeX string e.g. "\\pi r^2"
    where: Optional[str] = None

class DefinitionItem(BaseModel):
    term: str
    meaning: str

# Updated SummaryOutput
class SummaryOutput(BaseModel):
    shortSummary: str
    keyPoints: list[str]                          # renamed from bulletPoints
    formulas: list[FormulaItem] = []              # new, optional
    definitions: list[DefinitionItem] = []        # new, optional

    @field_validator("keyPoints")
    @classmethod
    def must_have_key_points(cls, v):
        if not v:
            raise ValueError("keyPoints must not be empty")
        if len(v) > 20:
            raise ValueError("keyPoints must not exceed 20 items")
        return v
```

